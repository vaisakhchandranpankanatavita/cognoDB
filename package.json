{
  "name": "cognodb-movie-recommendation",
  "version": "1.0.0",
  "description": "Movie recommendation engine powered by CognoDB graph database",
  "main": "server/index.js",
  "scripts": {
    "seed": "node scripts/seed.js",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "nodemon server/index.js",
    "dev:client": "cd client && npm start",
    "build": "cd client && npm run build",
    "start": "node server/index.js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": ["graph", "database", "recommendation", "cognodb"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "neo4j-driver": "^5.13.0",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "concurrently": "^8.2.1"
  }
}
